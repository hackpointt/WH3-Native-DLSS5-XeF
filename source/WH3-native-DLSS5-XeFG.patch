+// WH3 v12: metadata-only shadow feature. While FG is disabled it remains fully dormant:
+// no currentFeature assignment, no FG state calls, and no shadow frame advancement.
+class WH3NativeDlssInputFeature final : public IFeature_Dx12
+{
+  public:
+    WH3NativeDlssInputFeature(unsigned int handleId, NVSDK_NGX_Parameter* params)
+        : IFeature(handleId, params), IFeature_Dx12(handleId, params)
+    {
+        _initParameters = SetInitParameters(params);
+        SetInit(_initParameters);
+        LOG_INFO("WH3 native DLSS bridge: shadow init: {}, IsInitParameters {}, Render {}x{}, Display {}x{}, Flags 0x{:X}, LowResMV {}, DepthInverted {}, JitteredMV {}",
+                 IsInited(), IsInitParameters(), RenderWidth(), RenderHeight(), DisplayWidth(), DisplayHeight(), GetFeatureFlags(),
+                 LowResMV(), DepthInverted(), JitteredMV());
+    }
+
+    bool InitInternal(ID3D12GraphicsCommandList*, NVSDK_NGX_Parameter*) override { return true; }
+    bool EvaluateInternal(ID3D12GraphicsCommandList*, NVSDK_NGX_Parameter*) override { return true; }
+    feature_version Version() override { return feature_version { 0, 0, 0 }; }
+    Upscaler GetUpscalerType() const final { return Upscaler::DLSS; }
+    bool IsWithDx12() override { return false; }
+    void AdvanceFrame() { _frameCount++; }
+};
+
+static std::unordered_map<unsigned int, std::unique_ptr<WH3NativeDlssInputFeature>> wh3NativeInputFeatures;
+
 class ScopedInitDx12
