+            WH3NativeDlssInputFeature* bridgeFeature = nullptr;
+            bool wh3BridgeRunning = false;
+            const bool wh3NativeBridge =
+                _wcsicmp(Util::ExePath().filename().wstring().c_str(), L"Warhammer3.exe") == 0 &&
+                feature == NVSDK_NGX_Feature_SuperSampling && InParameters != nullptr &&
+                State::Instance().activeFgInput == FGInput::Upscaler;
+
+            if (wh3NativeBridge)
+            {
+                auto it = wh3NativeInputFeatures.find(handleId);
+                if (it == wh3NativeInputFeatures.end())
+                {
+                    auto shadow = std::make_unique<WH3NativeDlssInputFeature>(handleId, InParameters);
+                    bridgeFeature = shadow.get();
+                    wh3NativeInputFeatures.emplace(handleId, std::move(shadow));
+                    LOG_INFO("WH3 native DLSS bridge: created for native handle {}", handleId);
+                }
+                else
+                {
+                    bridgeFeature = it->second.get();
+                }
+
+                if (bridgeFeature != nullptr && bridgeFeature->IsInitParameters())
+                {
+                    const bool fgEnabled = Config::Instance()->FGEnabled.value_or_default();
+                    if (fgEnabled)
+                    {
+                        // V11 proved that merely publishing the shadow object as currentFeature while
+                        // FG was disabled was enough to wedge the following Present. Publish it only
+                        // for an explicitly enabled FG frame.
+                        // V13: keep the metadata-only shadow object private. Publishing it through
+                        // State::currentFeature makes LocalPresent treat it like a real initialized
+                        // upscaler and enter GPU-timing/frozen-check paths the shadow does not own.
+                        // UpscalerInputsDx12 already receives the feature explicitly, and XeFG can
+                        // activate from low-res MV metadata without currentFeature.
+                        wh3BridgeRunning = true;
+                        static bool wh3V13Logged = false;
+                        if (!wh3V13Logged)
+                        {
+                            LOG_INFO("WH3 native DLSS bridge: private shadow active; currentFeature untouched");
+                            wh3V13Logged = true;
+                        }
+
+                        UpscalerInputsDx12::UpscaleStart(InCmdList, InParameters, bridgeFeature);
+                        UpscalerInputsDx12::UpscaleEnd(InCmdList, InParameters, bridgeFeature);
+
+                        static uint64_t wh3BridgeCounter = 0;
+                        wh3BridgeCounter++;
+                        if (wh3BridgeCounter <= 12 || (wh3BridgeCounter % 300) == 0)
+                        {
+                            auto fg = State::Instance().currentFG;
+                            LOG_INFO("WH3 native DLSS bridge: tick #{}: FGEnabled {}, fg {}, active {}, paused {}, depth {}, velocity {}, frame {}",
+                                     wh3BridgeCounter, fgEnabled, fg != nullptr,
+                                     fg != nullptr ? fg->IsActive() : false,
+                                     fg != nullptr ? fg->IsPaused() : false,
+                                     fg != nullptr ? fg->HasResource(FG_ResourceType::Depth) : false,
+                                     fg != nullptr ? fg->HasResource(FG_ResourceType::Velocity) : false,
+                                     fg != nullptr ? fg->FrameCount() : 0);
+                        }
+                    }
+                    else
+                    {
+                        if (State::Instance().currentFeature == bridgeFeature)
+                            State::Instance().currentFeature = nullptr;
+
+                        static uint64_t wh3DormantCounter = 0;
+                        wh3DormantCounter++;
+                        if (wh3DormantCounter <= 3 || (wh3DormantCounter % 300) == 0)
+                            LOG_INFO("WH3 native DLSS bridge: dormant: FG disabled; currentFeature untouched");
+                    }
+                }
+                else
+                {
+                    LOG_ERROR("WH3 native DLSS bridge: blocked: shadow feature missing init parameters");
+                }
+            }
+
             LOG_DEBUG("Passthrough to native DLSS EvaluateFeature for handle {}", handleId);
             NVSDK_NGX_Result result =
                 NVNGXProxy::D3D12_EvaluateFeature()(InCmdList, InFeatureHandle, InParameters, InCallback);
             LOG_DEBUG("Native DLSS EvaluateFeature result: 0x{:X}", (uint32_t) result);
+
+            if (wh3NativeBridge && result == NVSDK_NGX_Result_Success)
+                State::Instance().wh3NativeDlssLastSuccessTick.store(GetTickCount64(), std::memory_order_relaxed);
+
+            if (wh3BridgeRunning && bridgeFeature != nullptr)
+                bridgeFeature->AdvanceFrame();
+
             return result;
         }
 
