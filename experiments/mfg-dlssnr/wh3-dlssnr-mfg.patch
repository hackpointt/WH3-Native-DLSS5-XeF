+bool WaitForQueueIdle(ID3D12CommandQueue* queue, ID3D12Fence* fence, HANDLE fenceEvent, UINT64& fenceValue)
+{
+    if (queue == nullptr || fence == nullptr || fenceEvent == nullptr)
+        return false;
+
+    const UINT64 waitValue = ++fenceValue;
+    if (FAILED(queue->Signal(fence, waitValue)))
+        return false;
+    if (fence->GetCompletedValue() >= waitValue)
+        return true;
+    if (FAILED(fence->SetEventOnCompletion(waitValue, fenceEvent)))
+        return false;
+    return WaitForSingleObject(fenceEvent, 5000) == WAIT_OBJECT_0;
+}
