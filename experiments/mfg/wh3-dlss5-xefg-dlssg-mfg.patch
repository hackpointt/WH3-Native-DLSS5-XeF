+void Dx11wDx12SC::_TryActivateWh3Dlssg()
+{
+    if (_deferredFactory == nullptr || _wh3DlssgAttempted || _fgSwapChain == nullptr ||
+        _dx12Device == nullptr || _dx12CommandQueue == nullptr ||
+        State::Instance().wh3NativeDlssLastSuccessTick.load(std::memory_order_relaxed) == 0)
+        return;
+
+    _wh3DlssgAttempted = true;
+    LOG_INFO("WH3 DLSSG two-stage: native DLSS evaluated; recreating presenter with Streamline");
+
+    DXGI_SWAP_CHAIN_DESC desc {};
+    if (FAILED(_fgSwapChain->GetDesc(&desc)))
+    {
+        LOG_ERROR("WH3 DLSSG two-stage: could not read plain presenter descriptor");
+        return;
+    }
+
+    if (!_WaitForCopyQueueIdle())
+    {
+        LOG_ERROR("WH3 DLSSG two-stage: interop copy queue did not become idle");
+        return;
+    }
+
+    ID3D12Fence* presentFence = nullptr;
+    const auto fenceResult = _dx12Device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&presentFence));
+    HANDLE presentEvent = SUCCEEDED(fenceResult) ? CreateEvent(nullptr, FALSE, FALSE, nullptr) : nullptr;
+    UINT64 fenceValue = 0;
+    const bool presentIdle = presentFence != nullptr && presentEvent != nullptr &&
+                             WaitForQueueIdle(_dx12CommandQueue, presentFence, presentEvent, fenceValue);
+    SafeRelease(presentFence);
+    SafeCloseHandle(presentEvent);
+    if (!presentIdle)
+    {
+        LOG_ERROR("WH3 DLSSG two-stage: present queue did not become idle");
+        return;
+    }
+
+    MenuOverlayDx::CleanupRenderTarget(true, _handle);
+    _ReleaseInteropObjects();
+    FGHooks::ClearDx12InteropPresentSC(_fgSwapChain);
+    State::Instance().currentFGSwapchain = nullptr;
+    SafeRelease(_fgSwapChain);
+
+    IDXGISwapChain* replacement = nullptr;
+    auto result = DxgiFactoryHooks::CreateFgDx12InteropSwapChain(_deferredFactory, _dx12CommandQueue, &desc,
+                                                                   &replacement);
+    if (SUCCEEDED(result) && replacement != nullptr)
+    {
+        result = replacement->QueryInterface(IID_PPV_ARGS(&_fgSwapChain));
+        replacement->Release();
+        replacement = nullptr;
+    }
+
+    if (FAILED(result) || _fgSwapChain == nullptr)
+    {
+        LOG_ERROR("WH3 DLSSG two-stage: Streamline presenter failed {:X}; restoring plain DX12 presenter",
+                  (UINT) result);
+        if (replacement != nullptr)
+            replacement->Release();
+
+        result = DxgiFactoryHooks::CreatePlainDx12InteropSwapChain(_deferredFactory, _dx12CommandQueue, &desc,
+                                                                    &replacement);
+        if (SUCCEEDED(result) && replacement != nullptr)
+        {
+            result = replacement->QueryInterface(IID_PPV_ARGS(&_fgSwapChain));
+            replacement->Release();
+        }
+        if (SUCCEEDED(result) && _fgSwapChain != nullptr)
+        {
+            FGHooks::SetDx12InteropPresentSC(_fgSwapChain, _handle);
+            State::Instance().currentFGSwapchain = _fgSwapChain;
+            LOG_INFO("WH3 DLSSG two-stage: plain presenter restored; frame generation remains off");
+        }
+        else
+        {
+            LOG_ERROR("WH3 DLSSG two-stage: plain presenter recovery failed {:X}", (UINT) result);
+        }
+    }
+    else
+    {
+        _fg = State::Instance().currentFG;
+        State::Instance().currentFGSwapchain = _fgSwapChain;
+        LOG_INFO("WH3 DLSSG two-stage: Streamline presenter active after native DLSS success");
+    }
+
+    State::Instance().currentSwapchain = this;
+    State::Instance().currentWrappedSwapchain = this;
+    State::Instance().currentSwapchainDesc = desc;
+    _RefreshCachedSwapchainDesc();
+}
